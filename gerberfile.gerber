(EXPERT_MASTER_GERBER
  (VERSION 1.0)
  (TITLE "Extreme Performance Laptop - Aerospace Grade Gerber Outputs")

  ;; ===========================
  ;; Copper Layers
  ;; ===========================
  (FILE TopCopper.GBR
    (CONTENT "Layer1: Signal traces, 2oz copper")
    (RULES "DDR5 50Ω, PCIe Gen5 100Ω diff, USB PD 90Ω diff")
  )
  (FILE InnerCopper1.GBR
    (CONTENT "Layer3: High-speed PCIe/DDR5 differential pairs")
    (RULES "Length match ±5 mils, jitter <0.15UI")
  )
  (FILE InnerCopper2.GBR
    (CONTENT "Layer4: Power plane 1.2V/3.3V/5V")
    (RULES "VRM rails, decoupling caps within 2mm")
  )
  (FILE BottomCopper.GBR
    (CONTENT "Layer10: Signal traces, 2oz copper")
    (RULES "Audio shielded nets, THD+N ≤-120dB")
  )

  ;; ===========================
  ;; Drill Files
  ;; ===========================
  (FILE Drill.DRL
    (CONTENT "Plated through holes 0.3–0.5mm, microvias 0.1mm laser")
    (RULES "Blind/buried vias enabled, backdrill for PCIe Gen5 lanes")
  )

  ;; ===========================
  ;; Solder Mask
  ;; ===========================
  (FILE SolderMaskTop.GBR
    (CONTENT "Green solder mask, controlled openings for BGA pads")
    (RULES "IPC-7351 compliant clearances")
  )
  (FILE SolderMaskBottom.GBR
    (CONTENT "Green solder mask, controlled openings for connectors")
    (RULES "Moisture/ESD conformal coating applied")
  )

  ;; ===========================
  ;; Silkscreen
  ;; ===========================
  (FILE SilkscreenTop.GBR
    (CONTENT "Component outlines, reference designators, polarity marks")
    (RULES "Readable font ≥0.8mm, white ink")
  )
  (FILE SilkscreenBottom.GBR
    (CONTENT "Assembly notes, connector orientation, test points")
    (RULES "Readable font ≥0.8mm, white ink")
  )

  ;; ===========================
  ;; Fabrication Notes
  ;; ===========================
  (FABRICATION
    (Compliance "RoHS CE BIS UL CCC FIPS140-3 NIST-SP800-193 IEC62368-1")
    (Finish "ENIG - Electroless Nickel Immersion Gold")
    (Dielectric "Rogers RO4003, 0.2mm core")
    (AOI "Orbotech AOI validation")
    (FlyingProbe "ATG impedance test")
    (ThermalCycling "Validation chamber -40°C to +85°C")
    (VibrationShock "MIL-STD-810G compliance")
    (Humidity "85% RH chamber validation")
  )
)
