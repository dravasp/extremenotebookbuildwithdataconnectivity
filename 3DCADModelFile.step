(EXPERT_MASTER_STEP
  (VERSION 2.6)
  (TITLE "Extreme Performance Laptop - Aerospace Grade 3D CAD Model (X75 Edition)")

  ;; ===========================
  ;; Enclosure Geometry
  ;; ===========================
  (CHASSIS
    (Material "Aerospace Aluminum 7075-T6")
    (Dimensions "360mm x 250mm x 18mm base, 360mm x 250mm x 5mm lid")
    (Tolerance "±0.05mm holes, ±0.1mm enclosure fit")
    (Features
      (Hinges "Titanium Ti-6Al-4V, 50,000 cycle rating")
      (VentSlots "2mm x 40mm, 12 slots evenly spaced")
      (SpeakerGrill "1mm perforations, 60% open area")
      (WWAN_M2_Slot "3052 Key B, CNC reinforced mount")
      (NanoSIM_Cage "Spring-loaded slot, 1.2mm tolerance, dust shield")
      (BatteryPocket "150mm x 95mm x 10mm cavity for graphene 150 Wh/kg pack")
    )
  )

  ;; ===========================
  ;; Display Integration
  ;; ===========================
  (DISPLAY
    (Component "AUO MicroLED UHD Panel")
    (Opening "340mm x 220mm cutout")
    (Mount "Custom LVDS connector, recessed bezel")
    (Flux "50W dissipation, copper spreaders integrated")
    (Compliance "EMI/ESD shielding, MIL-STD-810G vibration tolerance")
  )

  ;; ===========================
  ;; Battery Pack
  ;; ===========================
  (BATTERY
    (Component "Graphene Solid-State Pack, 150 Wh/kg")
    (Pocket "Recessed cavity under palm rest")
    (Dimensions "150mm x 95mm x 10mm")
    (SMBus "Header integrated for monitoring")
    (Safety "Non-flammable electrolyte, UL IEC BIS certified")
    (Endurance "≥30 hours continuous runtime")
  )

  ;; ===========================
  ;; Thermal Management
  ;; ===========================
  (THERMAL
    (GrapheneVaporChamber "≥1500W/mK conductivity, 300W load capacity")
    (LiquidMetalTIM "Coverage ≥95%, resistance <0.01K/W")
    (DysonBlower "Bladeless ionic blower, >20CFM airflow, <25dBA noise")
    (CopperInserts "CPU pocket 40x40x2mm, GPU pocket 50x50x2mm, NPU pocket 35x35x2mm")
    (SensorMounts "Ø2mm drill holes for thermal probes")
  )

  ;; ===========================
  ;; Ports & Slots
  ;; ===========================
  (PORTS
    (USB_PD "2x USB-C EPR 240W, chamfered cutouts")
    (DC_Jack "Ø8mm barrel jack, reinforced mount")
    (SDExpress "24mm x 2.1mm slot, right edge placement")
    (QSFP_DD "18mm x 14mm cage opening")
    (BluRayDrive "128mm x 12.7mm slimline slot")
    (WWAN_Antenna "Dual RF connectors, shielded routing channels")
  )

  ;; ===========================
  ;; Ergonomics
  ;; ===========================
  (ERGONOMICS
    (Keypad "Numeric, white backlight, no RGB")
    (Trackpad "130x90mm glass, centered below keyboard")
    (PowerButton "Isolated near hinge axis")
    (SurfaceFinish "Anodized aluminum + PVD coating")
    (NanoSIM_Access "Accessible slot, CNC cutout with dust shield")
  )

  ;; ===========================
  ;; WWAN Integration
  ;; ===========================
  (WWAN_X75
    (Component "Qualcomm Snapdragon X75 WWAN")
    (Slot "M.2 3052 Key B")
    (Profiles "20 stored, 1–5 active simultaneously")
    (NanoSIM "Physical slot, hardware backed")
    (LPA "Local Profile Assistant, GSMA-SGP.32 compliant")
    (Voice "Enabled")
    (SMS "Enabled")
    (USSD "Enabled")
    (APN_QoS "Multi-carrier, max throughput 256 Mbps UL/DL")
    (PDP_Contexts "IPv4v6, multi-bearer, stable comms")
    (Security "UEFI Secure Boot, Intel Boot Guard, ARM TrustZone, Microsoft Pluton, TPM, HSM, fTPM, OpenTitan RoT")
  )
)
