(EXPERT_MASTER_CNC_DXF
  (VERSION 2.6)
  (TITLE "Extreme Performance Laptop - Aerospace Grade CNC Machining (X75 Edition)")

  ;; ===========================
  ;; Chassis Base
  ;; ===========================
  (SECTION BASE_PLATE
    (Material "Aerospace Aluminum 7075-T6")
    (Operations
      (Op1 "Mill base outline 360mm x 250mm x 18mm")
      (Op2 "Cut venting slots: 2mm x 40mm, 12 slots evenly spaced")
      (Op3 "Drill mounting holes: M2.5, tolerance ±0.05mm")
      (Op4 "Pocket recess for graphene solid-state battery pack: 150mm x 95mm x 10mm cavity, endurance validated for 30+ hours")
      (Op5 "Machine WWAN M.2 3052 Key B slot with reinforced mount, PCIe Gen5 backdrill")
      (Op6 "CNC cutout for Nano-SIM cage, spring-loaded contacts, 1.2mm tolerance, dust shield integration")
    )
  )

  ;; ===========================
  ;; Chassis Lid
  ;; ===========================
  (SECTION LID_PLATE
    (Material "Aerospace Aluminum 7075-T6")
    (Operations
      (Op1 "Mill lid outline 360mm x 250mm x 5mm")
      (Op2 "Laser cut display opening: 340mm x 220mm")
      (Op3 "Drill hinge mounts: Titanium Ti-6Al-4V, 50,000 cycle rating")
      (Op4 "Cut speaker grill: 1mm perforations, 60% open area")
      (Op5 "Add antenna routing channels for WWAN RF shielding, impedance matched grooves")
    )
  )

  ;; ===========================
  ;; Port Openings
  ;; ===========================
  (SECTION PORTS
    (Operations
      (Op1 "USB-C PD ports: 8mm x 3mm rectangular cutouts, chamfered edges")
      (Op2 "DC barrel jack: Ø8mm circular cutout")
      (Op3 "SD Express slot: 24mm x 2.1mm opening, right edge placement")
      (Op4 "QSFP-DD cage: 18mm x 14mm rectangular cutout")
      (Op5 "Blu-ray SATA drive: 128mm x 12.7mm slimline slot")
      (Op6 "WWAN antenna connectors: dual RF cutouts, shielded path, 5G NR Sub-6 + mmWave support")
    )
  )

  ;; ===========================
  ;; Thermal Inserts
  ;; ===========================
  (SECTION THERMAL_INSERTS
    (Material "Copper alloy + Graphene vapor chamber")
    (Operations
      (Op1 "Pocket recess under CPU zone: 40mm x 40mm x 2mm")
      (Op2 "Pocket recess under GPU zone: 50mm x 50mm x 2mm")
      (Op3 "Pocket recess under NPU zone: 35mm x 35mm x 2mm")
      (Op4 "Drill thermal sensor mounting holes Ø2mm")
      (Op5 "Mount Dyson ionic blower cavity, airflow >20CFM, <25dBA noise")
    )
  )

  ;; ===========================
  ;; Tolerances & Validation
  ;; ===========================
  (TOLERANCES
    (Dimensional "±0.05mm holes, ±0.1mm enclosure fit")
    (SurfaceFinish "Anodized aluminum, PVD coating")
    (Validation "CMM inspection, vibration/shock MIL-STD-810G compliance, WWAN RF impedance validation, endurance validation for graphene battery load")
  )
)
