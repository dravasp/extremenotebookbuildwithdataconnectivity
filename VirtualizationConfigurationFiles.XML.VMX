(EXPERT_MASTER_VIRTUALIZATION
  (VERSION 1.1)
  (TITLE "Extreme Performance Laptop - Aerospace Grade Virtualization Configurations (Re‑worked)")

  ;; ===========================
  ;; Proxmox / KVM (.XML)
  ;; ===========================
  (PROXMOX_VM_XML
    (File "proxmox_vm.xml")
    (VM "Ubuntu 24.04 GPU/NPU accelerated node")
    (Resources
      (CPU "8 cores, Intel i9 passthrough")
      (Memory "32GB DDR5X, ECC enabled")
      (Storage "NVMe Gen5 SSD, 1TB, TRIM enabled")
      (GPU "NVIDIA Ada5090M passthrough with CUDA/TensorRT")
      (NPU "Intel TOPS45 passthrough with ONNX runtime")
    )
    (Networking
      (Interface "QSFP-DD 400G, VLAN segmentation, SR-IOV enabled")
      (Bridge "vmbr0, PCIe tunneling enabled, jumbo frames supported")
    )
    (Security
      (RootOfTrust "OpenTitan validation, secure boot chain")
      (Keys "YubiHSM2 hardware key storage, PKCS#11 integration")
    )
  )

  ;; ===========================
  ;; VMware ESXi (.VMX)
  ;; ===========================
  (VMWARE_VM_VMX
    (File "win11_enterprise.vmx")
    (VM "Windows 11 Enterprise GPU workstation")
    (Resources
      (CPU "12 cores, Intel i9 passthrough, Hyper-Threading enabled")
      (Memory "64GB DDR5X, NUMA aware allocation")
      (Storage "NVMe Gen5 SSD, 2TB, RAID-1 mirror")
      (GPU "NVIDIA Ada5090M passthrough, DirectX12 acceleration")
      (Thunderbolt "PCIe tunneling enabled, hot-plug supported")
    )
    (Networking
      (Interface "QSFP-DD 400G, VLAN tagging")
      (vSwitch "vSwitch0, VLAN segmentation, NSX-T integration")
    )
    (Security
      (SecureBoot "UEFI Secure Boot enabled, BitLocker integration")
      (TPM "Infineon SLB9670 virtual TPM, attestation enabled")
    )
  )

  ;; ===========================
  ;; Hyper-V (.XML)
  ;; ===========================
  (HYPERV_VM_XML
    (File "hyperv_cluster.xml")
    (VM "Windows Server 2025 cluster node")
    (Resources
      (CPU "16 cores, Intel i9 passthrough, nested virtualization enabled")
      (Memory "128GB DDR5X, dynamic memory allocation")
      (Storage "NVMe Gen5 SSD, 4TB RAID-10, Storage Spaces Direct")
      (GPU "NVIDIA Ada5090M passthrough, CUDA/DirectML acceleration")
      (NPU "Intel TOPS45 passthrough, ONNX runtime integration")
    )
    (Networking
      (Interface "QSFP-DD 400G, RDMA enabled")
      (Bridge "Hyper-V virtual switch, VLAN trunking")
    )
    (Security
      (Pluton "Microsoft Pluton secure enclave, firmware attestation")
      (Policies "FIPS140-3, NIST SP800-193 compliance, Shielded VM support")
    )
  )
)
