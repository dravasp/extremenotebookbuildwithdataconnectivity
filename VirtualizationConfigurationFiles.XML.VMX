(EXPERT_MASTER_VIRTUALIZATION
  (VERSION 1.0)
  (TITLE "Extreme Performance Laptop - Aerospace Grade Virtualization Configs")

  ;; ===========================
  ;; Proxmox / KVM (.XML)
  ;; ===========================
  (PROXMOX_VM_XML
    (File "proxmox_vm.xml")
    (VM "Ubuntu 24.04 GPU/NPU accelerated node")
    (Resources
      (CPU "8 cores, Intel i9 passthrough")
      (Memory "32GB DDR5X")
      (Storage "NVMe Gen5 SSD, 1TB")
      (GPU "NVIDIA Ada5090M passthrough")
      (NPU "Intel TOPS45 passthrough")
    )
    (Networking
      (Interface "QSFP-DD 400G, VLAN segmentation")
      (Bridge "vmbr0, PCIe tunneling enabled")
    )
    (Security
      (RootOfTrust "OpenTitan validation")
      (Keys "YubiHSM2 hardware key storage")
    )
  )

  ;; ===========================
  ;; VMware ESXi (.VMX)
  ;; ===========================
  (VMWARE_VM_VMX
    (File "win11_enterprise.vmx")
    (VM "Windows 11 Enterprise GPU workstation")
    (Resources
      (CPU "12 cores, Intel i9 passthrough")
      (Memory "64GB DDR5X")
      (Storage "NVMe Gen5 SSD, 2TB")
      (GPU "NVIDIA Ada5090M passthrough")
      (Thunderbolt "PCIe tunneling enabled")
    )
    (Networking
      (Interface "QSFP-DD 400G")
      (vSwitch "vSwitch0, VLAN segmentation")
    )
    (Security
      (SecureBoot "UEFI Secure Boot enabled")
      (TPM "Infineon SLB9670 virtual TPM")
    )
  )

  ;; ===========================
  ;; Hyper-V (.XML)
  ;; ===========================
  (HYPERV_VM_XML
    (File "hyperv_cluster.xml")
    (VM "Windows Server 2025 cluster node")
    (Resources
      (CPU "16 cores, Intel i9 passthrough")
      (Memory "128GB DDR5X")
      (Storage "NVMe Gen5 SSD, 4TB RAID-10")
      (GPU "NVIDIA Ada5090M passthrough")
      (NPU "Intel TOPS45 passthrough")
    )
    (Networking
      (Interface "QSFP-DD 400G")
      (Bridge "Hyper-V virtual switch")
    )
    (Security
      (Pluton "Microsoft Pluton secure enclave")
      (Policies "FIPS140-3, NIST SP800-193 compliance")
    )
  )
)
