(EXPERT_MASTER_OS_IMAGES
  (VERSION 1.0)
  (TITLE "Extreme Performance Laptop - Aerospace Grade OS Images")

  ;; ===========================
  ;; Windows Builds
  ;; ===========================
  (WINDOWS_ISO
    (File "win11_enterprise.iso")
    (OS "Windows 11 Enterprise")
    (Features "UEFI Secure Boot, Pluton integration, TPM validation")
    (Drivers "GPU, NPU, Thunderbolt, WiFi7, NVMe preloaded")
    (Productivity "Office, AutoCAD, Adobe Creative Suite, .NET Core, VS Code")
  )
  (WINDOWS_SERVER_ISO
    (File "win_server2025.iso")
    (OS "Windows Server 2022/2025")
    (Features "Hyper-V, Active Directory, Pluton secure enclave")
    (Drivers "Storage, QSFP-DD networking, Thunderbolt5")
  )

  ;; ===========================
  ;; Linux Builds
  ;; ===========================
  (UBUNTU_ISO
    (File "ubuntu_24.04.iso")
    (OS "Ubuntu 22.04/24.04 LTS")
    (Features "Systemd, Snap, AppArmor")
    (Drivers "GPU CUDA, NPU ONNX, WiFi7, NVMe Gen5")
  )
  (REDHAT_ISO
    (File "rhel_ubi9.iso")
    (OS "Red Hat UBI8/UBI9")
    (Features "SELinux, Podman, OpenShift ready")
    (Drivers "PCIe Gen5, QSFP-DD, Thunderbolt5")
  )
  (ROCKY_ISO
    (File "rocky_2026.iso")
    (OS "Rocky/AlmaLinux 2026")
    (Features "Enterprise stability, kernel 6.x")
    (Drivers "GPU/NPU, NVMe, WiFi7")
  )
  (FEDORA_ISO
    (File "fedora_2026.iso")
    (OS "Fedora 2026")
    (Features "Wayland, PipeWire, SELinux")
    (Drivers "GPU Vulkan, DSP audio stack")
  )
  (SUSE_ISO
    (File "suse_15sp5.iso")
    (OS "SUSE Linux Enterprise 15 SP5")
    (Features "YaST, Btrfs, Snapper rollback")
    (Drivers "Storage, QSFP-DD networking")
  )

  ;; ===========================
  ;; BSD & Solaris Builds
  ;; ===========================
  (FREEBSD_ISO
    (File "freebsd_14.iso")
    (OS "FreeBSD 14")
    (Features "ZFS, Jails, PF firewall")
    (Drivers "NVMe Gen5, QSFP-DD, Audio stack")
  )
  (SOLARIS_ISO
    (File "solaris_11.iso")
    (OS "Solaris 11")
    (Features "SMF, ZFS, DTrace")
    (Drivers "PCIe Gen5, GPU/NPU integration")
  )

  ;; ===========================
  ;; Virtualization Builds
  ;; ===========================
  (PROXMOX_ISO
    (File "proxmox_8.iso")
    (OS "Proxmox VE 8")
    (Features "KVM, LXC, Ceph integration")
    (Drivers "GPU passthrough, NVMe storage")
  )
  (VMWARE_ESXI_ISO
    (File "esxi_8.iso")
    (OS "VMware ESXi 7/8")
    (Features "vSphere, VMX config support")
    (Drivers "GPU/NPU passthrough, QSFP-DD networking")
  )

  ;; ===========================
  ;; Image Packaging
  ;; ===========================
  (PACKAGING
    (Format ".ISO and .IMG")
    (Boot "UEFI Secure Boot enabled")
    (Signing "SHA-512, RSA-4096, Pluton keychain")
    (Provisioning "Preloaded drivers, automated install scripts")
    (Recovery "Dual image fallback, rollback protection")
  )
)
