(EXPERT_MASTER_OS_IMAGES
  (VERSION 2.6)
  (TITLE "Extreme Performance Laptop - Aerospace Grade OS Images (X75 Edition)")

  ;; ===========================
  ;; Windows Builds
  ;; ===========================
  (WINDOWS_ISO
    (File "win11_enterprise.iso")
    (OS "Windows 11 Enterprise")
    (Features "UEFI Secure Boot, Pluton integration, TPM validation, WWAN provisioning")
    (Drivers "GPU, NPU, Thunderbolt5, WiFi7, NVMe Gen5, WWAN X75 preloaded")
    (Productivity "Office, AutoCAD, Adobe Creative Suite, .NET Core, VS Code, QMI SDK")
    (WWAN "20 stored profiles, 1–5 active, IMS/VoLTE/VoNR, USSD, APN/QoS")
  )
  (WINDOWS_SERVER_ISO
    (File "win_server2025.iso")
    (OS "Windows Server 2022/2025")
    (Features "Hyper-V, Active Directory, Pluton secure enclave, WWAN integration")
    (Drivers "Storage, QSFP-DD networking, Thunderbolt5, WWAN X75")
  )

  ;; ===========================
  ;; Linux Builds
  ;; ===========================
  (UBUNTU_ISO
    (File "ubuntu_24.04.iso")
    (OS "Ubuntu 22.04/24.04 LTS")
    (Features "Systemd, Snap, AppArmor, WWAN kernel integration")
    (Drivers "GPU CUDA, NPU ONNX, WiFi7, NVMe Gen5, WWAN X75 kernel module")
    (Provisioning "Docker, Kubernetes, VS Code, QMI SDK for APN/QoS")
  )
  (REDHAT_ISO
    (File "rhel_ubi9.iso")
    (OS "Red Hat UBI8/UBI9")
    (Features "SELinux, Podman, OpenShift ready, WWAN integration")
    (Drivers "PCIe Gen5, QSFP-DD, Thunderbolt5, WWAN X75")
  )
  (ROCKY_ISO
    (File "rocky_2026.iso")
    (OS "Rocky/AlmaLinux 2026")
    (Features "Enterprise stability, kernel 6.x, WWAN stack")
    (Drivers "GPU/NPU, NVMe, WiFi7, WWAN X75")
  )
  (FEDORA_ISO
    (File "fedora_2026.iso")
    (OS "Fedora 2026")
    (Features "Wayland, PipeWire, SELinux, WWAN integration")
    (Drivers "GPU Vulkan, DSP audio stack, WWAN X75")
  )
  (SUSE_ISO
    (File "suse_15sp5.iso")
    (OS "SUSE Linux Enterprise 15 SP5")
    (Features "YaST, Btrfs, Snapper rollback, WWAN integration")
    (Drivers "Storage, QSFP-DD networking, WWAN X75")
  )

  ;; ===========================
  ;; BSD & Solaris Builds
  ;; ===========================
  (FREEBSD_ISO
    (File "freebsd_14.iso")
    (OS "FreeBSD 14")
    (Features "ZFS, Jails, PF firewall, WWAN stack")
    (Drivers "NVMe Gen5, QSFP-DD, Audio stack, WWAN X75")
  )
  (SOLARIS_ISO
    (File "solaris_11.iso")
    (OS "Solaris 11")
    (Features "SMF, ZFS, DTrace, WWAN integration")
    (Drivers "PCIe Gen5, GPU/NPU integration, WWAN X75")
  )

  ;; ===========================
  ;; Virtualization Builds
  ;; ===========================
  (PROXMOX_ISO
    (File "proxmox_8.iso")
    (OS "Proxmox VE 8")
    (Features "KVM, LXC, Ceph integration, WWAN provisioning")
    (Drivers "GPU passthrough, NVMe storage, WWAN X75")
  )
  (VMWARE_ESXI_ISO
    (File "esxi_8.iso")
    (OS "VMware ESXi 7/8")
    (Features "vSphere, VMX config support, WWAN integration")
    (Drivers "GPU/NPU passthrough, QSFP-DD networking, WWAN X75")
  )

  ;; ===========================
  ;; Image Packaging
  ;; ===========================
  (PACKAGING
    (Format ".ISO and .IMG")
    (Boot "UEFI Secure Boot enabled")
    (Signing "SHA-512, RSA-4096, Pluton keychain, OpenTitan RoT")
    (Provisioning "Preloaded drivers, automated install scripts, WWAN APN/QoS provisioning")
    (Recovery "Dual image fallback, rollback protection, WWAN profile persistence")
  )
)
